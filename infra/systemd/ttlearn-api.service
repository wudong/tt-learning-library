[Unit]
Description=TT Learning Library API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ttlearn
Group=ttlearn
WorkingDirectory=/opt/tt-learning-library
EnvironmentFile=/etc/ttlearn/api.env
ExecStart=/usr/local/bin/bun apps/api/src/index.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/tt-learning-library

[Install]
WantedBy=multi-user.target
