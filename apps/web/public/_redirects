# Netlify deploys apps/web/dist from GitHub Actions. Files in public/ are copied
# into that publish directory, so these redirects are applied even when the
# deploy action does not upload the root netlify.toml.

# Native PWA share capture must stay same-origin and preserve the POST body.
/share-target  https://ttlearn-api.tourneypilot.com/share-target  200!

# Keep same-origin API calls working for app code paths that use plain fetch().
/api/*  https://ttlearn-api.tourneypilot.com/api/:splat  200!

# SPA fallback.
/*  /index.html  200
